// Sinbad's materials for physically based lighting, as used by the Character sample.
// With the metal_roughness lighting stage, the specular colour holds roughness and metallic.

abstract pass SinbadPBR/Pass
{
	rtshader_system
	{
		lighting_stage metal_roughness
		// reflect the sky, dimmer than the sun to keep the shadows visible
		image_based_lighting texture cloudy_noon.jpg luminance 0.25
	}
}

material SinbadPBR/Body
{
	receive_shadows on
	technique
	{
		pass : SinbadPBR/Pass
		{
			diffuse 1 1 1 1
			specular 0.55 0 0 1

			texture_unit
			{
				texture sinbad_body.tga
			}
		}
	}
}

material SinbadPBR/Gold
{
	receive_shadows on
	technique
	{
		pass : SinbadPBR/Pass
		{
			diffuse 0.8 0.8 0.8 1
			specular 0.3 1 0 1

